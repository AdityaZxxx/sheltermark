    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "knip": "^6.3.1",
    "lint-staged": "^16.4.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.79.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix"
    ],
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
