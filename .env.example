# All values below target the LOCAL Supabase stack (supabase start).
# Production credentials live only in Vercel env vars — never in local files.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# From `supabase start` output (Publishable / legacy anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_URL=http://127.0.0.1:54321
# From `supabase start` output (Secret / legacy service_role key)
SUPABASE_SERVICE_ROLE_KEY=

# Local direct connection (printed by `supabase start` as "Database URL").
# Production uses the transaction-mode pooler string (Dashboard > Connect > Pools).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=

# Cloud Backup v1 providers (optional until configured; see docs/adr/0008).
# Google Drive reuses the GOOGLE_CLIENT_* pair above.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Logging: debug | info | warn | error (default: info)
NEXT_PUBLIC_LOG_LEVEL=info

# AI Features (Ollama Cloud via Vercel AI SDK ollama-ai-provider-v2)
# Get your API key from https://ollama.com/settings/keys
# Model: e.g. minimax-m3:cloud (uses :cloud suffix for cloud models)
OLLAMA_API_KEY=
AI_MODEL=
